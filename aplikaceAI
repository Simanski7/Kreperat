
<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fotbalový Manažer & Taktický Simulátor | Šimon Kreperát</title>
  <meta name="description" content="Samostatná jednosouborová webová aplikace s fotbalovou tématikou: taktická tabule, zápasový simulátor, penaltový rozstřel a kvíz.">
  <style>
    /* ==========================================================================
       RESET & BASE DESIGN SYSTEM (60-30-10, ZERO EXTERNAL DEPENDENCIES)
       ========================================================================== */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg-canvas: #0b1310;
      --bg-surface: #13221c;
      --bg-surface-elevated: #1a2f26;
      --bg-surface-subtle: #0f1c16;
      --pitch-grass: #1b4d3e;
      --pitch-grass-light: #215e4c;
      --pitch-line: rgba(255, 255, 255, 0.75);
      --border-subtle: rgba(255, 255, 255, 0.1);
      --border-focus: #10b981;
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
      --accent-gold: #f59e0b;
      --accent-gold-hover: #d97706;
      --accent-emerald: #10b981;
      --accent-crimson: #ef4444;
      --accent-blue: #38bdf8;
      --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 14px;
      --shadow-card: 0 4px 20px rgba(0, 0, 0, 0.35);
      --transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    }

    body {
      background-color: var(--bg-canvas);
      color: var(--text-main);
      font-family: var(--font-stack);
      line-height: 1.5;
      font-size: 15px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      -webkit-font-smoothing: antialiased;
    }

    /* TOP BAR CONTRACT: Brand | 4-6 Nav Links | Primary Actions */
    header.top-bar {
      height: 64px;
      background-color: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .brand-title {
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: #ffffff;
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      white-space: nowrap;
    }

    .brand-title svg {
      width: 24px;
      height: 24px;
      color: var(--accent-emerald);
    }

    nav.nav-links {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .nav-btn {
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-muted);
      font-size: 14px;
      font-weight: 500;
      padding: 8px 14px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      transition: var(--transition);
    }

    .nav-btn:hover {
      color: var(--text-main);
      background-color: rgba(255, 255, 255, 0.05);
    }

    .nav-btn.active {
      color: #ffffff;
      background-color: var(--bg-surface-elevated);
      border-color: var(--border-subtle);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .btn-action {
      background-color: var(--accent-emerald);
      color: #062419;
      font-weight: 600;
      font-size: 13px;
      padding: 8px 16px;
      border-radius: var(--radius-sm);
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      transition: var(--transition);
    }

    .btn-action:hover {
      background-color: #34d399;
      transform: translateY(-1px);
    }

    .btn-secondary {
      background-color: rgba(255, 255, 255, 0.06);
      color: var(--text-main);
      font-weight: 500;
      font-size: 13px;
      padding: 8px 14px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-subtle);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      transition: var(--transition);
    }

    .btn-secondary:hover {
      background-color: rgba(255, 255, 255, 0.12);
    }

    /* MAIN CONTAINER */
    main.main-viewport {
      max-width: 1380px;
      width: 100%;
      margin: 0 auto;
      padding: 24px;
      flex: 1;
    }

    .tab-section {
      display: none;
      animation: fadeIn 0.2s ease-out forwards;
    }

    .tab-section.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* TYPOGRAPHY & HEADINGS (ANTI-SLOP: No // prefixes or pills) */
    .section-header {
      margin-bottom: 20px;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 14px;
    }

    .section-title {
      font-size: 22px;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: -0.01em;
    }

    .section-subtitle {
      font-size: 13px;
      color: var(--text-muted);
      margin-top: 4px;
    }

    /* GRID LAYOUTS */
    .dashboard-grid {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 24px;
    }

    @media (max-width: 1024px) {
      .dashboard-grid {
        grid-template-columns: 1fr;
      }
    }

    /* CARD STYLING */
    .app-card {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 20px;
      box-shadow: var(--shadow-card);
    }

    /* PITCH CONTAINER & FIELD */
    .pitch-wrapper {
      position: relative;
      background: radial-gradient(circle at center, var(--pitch-grass-light) 0%, var(--pitch-grass) 100%);
      border: 2px solid rgba(255, 255, 255, 0.4);
      border-radius: var(--radius-md);
      aspect-ratio: 16 / 10;
      min-height: 520px;
      overflow: hidden;
      box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.5);
      user-select: none;
    }

    /* Pitch Grass Stripes (Alternating bands) */
    .pitch-stripes {
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.05) 0,
        rgba(0, 0, 0, 0.05) 10%,
        transparent 10%,
        transparent 20%
      );
      pointer-events: none;
    }

    /* SVG Pitch Markings */
    .pitch-svg-lines {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }

    /* Pitch Player Token */
    .pitch-player {
      position: absolute;
      transform: translate(-50%, -50%);
      width: 60px;
      height: 70px;
      display: flex;
      flex-direction: column;
      align-items: center;
      cursor: grab;
      transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.15s ease;
      z-index: 10;
    }

    .pitch-player:active {
      cursor: grabbing;
      transform: translate(-50%, -50%) scale(1.08);
      z-index: 20;
    }

    .jersey-circle {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, #e11d48 0%, #9f1239 100%);
      border: 2px solid #ffffff;
      color: #ffffff;
      font-weight: 700;
      font-size: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 10px rgba(0,0,0,0.5);
      font-family: var(--font-mono);
    }

    .jersey-circle.gk {
      background: linear-gradient(135deg, #eab308 0%, #ca8a04 100%);
      color: #1a1a1a;
    }

    .jersey-circle.away {
      background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    }

    .player-label {
      margin-top: 4px;
      background: rgba(0, 0, 0, 0.75);
      color: #ffffff;
      font-size: 11px;
      font-weight: 600;
      padding: 1px 6px;
      border-radius: 4px;
      white-space: nowrap;
      text-align: center;
      max-width: 90px;
      overflow: hidden;
      text-overflow: ellipsis;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    /* FORMATION BAR */
    .tactics-control-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 16px;
      background-color: var(--bg-surface-subtle);
      padding: 12px 16px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-subtle);
    }

    .select-group {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .select-label {
      font-size: 13px;
      color: var(--text-muted);
      font-weight: 500;
    }

    select.app-select, input.app-input {
      background-color: var(--bg-surface-elevated);
      color: var(--text-main);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 6px 12px;
      font-size: 13px;
      font-family: inherit;
      outline: none;
      transition: var(--transition);
    }

    select.app-select:focus, input.app-input:focus {
      border-color: var(--accent-emerald);
    }

    /* MATCH SIMULATOR STYLES */
    .scoreboard-banner {
      background: linear-gradient(180deg, #13271f 0%, #0c1a14 100%);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 24px;
      text-align: center;
      margin-bottom: 24px;
    }

    .matchup-row {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 24px;
    }

    .team-badge-box {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .team-badge-box.home {
      justify-content: flex-end;
    }

    .team-badge-box.away {
      justify-content: flex-start;
      flex-direction: row-reverse;
    }

    .team-name {
      font-size: 20px;
      font-weight: 700;
      color: #ffffff;
    }

    .team-tactics-tag {
      font-size: 12px;
      color: var(--text-muted);
    }

    .score-display {
      background-color: #050a08;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: var(--radius-md);
      padding: 12px 28px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }

    .score-numbers {
      font-size: 42px;
      font-weight: 800;
      letter-spacing: 0.05em;
      color: #ffffff;
      font-family: var(--font-mono);
      line-height: 1;
    }

    .match-clock {
      font-size: 13px;
      font-weight: 600;
      color: var(--accent-emerald);
      font-family: var(--font-mono);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .live-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--accent-crimson);
      display: inline-block;
      animation: pulseLive 1.2s infinite;
    }

    @keyframes pulseLive {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }

    /* MATCH CONTROLS */
    .match-action-bar {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-top: 20px;
      flex-wrap: wrap;
    }

    /* COMMENTARY LOG */
    .commentary-feed {
      height: 380px;
      overflow-y: auto;
      background-color: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .comment-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-size: 13px;
      padding: 8px 10px;
      border-radius: var(--radius-sm);
      background-color: rgba(255, 255, 255, 0.02);
      border-left: 3px solid var(--border-subtle);
      animation: fadeIn 0.25s ease-out;
    }

    .comment-item.goal {
      border-left-color: var(--accent-gold);
      background-color: rgba(245, 158, 11, 0.08);
      font-weight: 600;
    }

    .comment-item.card {
      border-left-color: var(--accent-crimson);
      background-color: rgba(239, 68, 68, 0.08);
    }

    .comment-minute {
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--accent-emerald);
      white-space: nowrap;
      min-width: 32px;
    }

    /* STATS TABLE */
    .stats-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    .stats-table td {
      padding: 10px 4px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .stats-table tr:last-child td {
      border-bottom: none;
    }

    .stat-label {
      text-align: center;
      color: var(--text-muted);
      font-weight: 500;
      font-size: 12px;
    }

    .stat-val-home {
      text-align: right;
      font-weight: 700;
      font-family: var(--font-mono);
      width: 60px;
    }

    .stat-val-away {
      text-align: left;
      font-weight: 700;
      font-family: var(--font-mono);
      width: 60px;
    }

    /* PENALTY SHOOTOUT CANVAS VIEW */
    .penalty-arena {
      position: relative;
      background: linear-gradient(180deg, #10211a 0%, #08120e 100%);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 24px;
    }

    .goal-post-container {
      width: 100%;
      max-width: 680px;
      height: 300px;
      position: relative;
      background: radial-gradient(circle at bottom, rgba(16, 185, 129, 0.2) 0%, transparent 70%);
      border-bottom: 6px solid #15803d;
      display: flex;
      justify-content: center;
      align-items: flex-end;
    }

    /* The Goal Frame */
    .goal-frame {
      width: 80%;
      height: 220px;
      border: 8px solid #ffffff;
      border-bottom: none;
      position: relative;
      background: repeating-linear-gradient(
        45deg,
        rgba(255, 255, 255, 0.05),
        rgba(255, 255, 255, 0.05) 12px,
        rgba(255, 255, 255, 0.12) 12px,
        rgba(255, 255, 255, 0.12) 24px
      );
      box-shadow: 0 0 30px rgba(255, 255, 255, 0.15);
    }

    /* Target Zones for Click */
    .shoot-target-grid {
      position: absolute;
      inset: 0;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(2, 1fr);
      gap: 4px;
      padding: 6px;
    }

    .target-cell {
      border: 1px dashed rgba(255, 255, 255, 0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: rgba(255, 255, 255, 0.6);
      font-size: 11px;
      font-weight: 600;
      border-radius: 4px;
      transition: var(--transition);
      background-color: rgba(0, 0, 0, 0.15);
    }

    .target-cell:hover {
      background-color: rgba(16, 185, 129, 0.25);
      border-color: var(--accent-emerald);
      color: #ffffff;
      transform: scale(0.98);
    }

    /* Goalkeeper on Pitch */
    .goalkeeper-figure {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 64px;
      height: 90px;
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      pointer-events: none;
      z-index: 15;
    }

    /* Ball Sprite */
    .penalty-ball {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      width: 32px;
      height: 32px;
      transition: all 0.5s cubic-bezier(0.25, 1, 0.5, 1);
      z-index: 20;
    }

    /* Scoreboard for Shootout */
    .shootout-tracker {
      display: flex;
      align-items: center;
      gap: 28px;
      margin-top: 24px;
      font-family: var(--font-mono);
    }

    .shootout-team {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .kick-dot {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.3);
      display: inline-block;
    }

    .kick-dot.scored {
      background-color: var(--accent-emerald);
      border-color: var(--accent-emerald);
      box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
    }

    .kick-dot.missed {
      background-color: var(--accent-crimson);
      border-color: var(--accent-crimson);
    }

    /* QUIZ SECTION */
    .quiz-container {
      max-width: 780px;
      margin: 0 auto;
    }

    .quiz-card {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 28px;
      box-shadow: var(--shadow-card);
    }

    .quiz-question {
      font-size: 18px;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 20px;
      line-height: 1.4;
    }

    .quiz-options {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .quiz-btn {
      text-align: left;
      background-color: var(--bg-surface-elevated);
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      padding: 14px 18px;
      border-radius: var(--radius-sm);
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: var(--transition);
    }

    .quiz-btn:hover:not(:disabled) {
      background-color: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.3);
      transform: translateX(4px);
    }

    .quiz-btn.correct {
      background-color: rgba(16, 185, 129, 0.2);
      border-color: var(--accent-emerald);
      color: #34d399;
    }

    .quiz-btn.wrong {
      background-color: rgba(239, 68, 68, 0.2);
      border-color: var(--accent-crimson);
      color: #f87171;
    }

    /* FOOTER */
    footer.app-footer {
      border-top: 1px solid var(--border-subtle);
      padding: 20px 24px;
      background-color: var(--bg-surface-subtle);
      margin-top: auto;
    }

    .footer-content {
      max-width: 1380px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      font-size: 13px;
      color: var(--text-muted);
    }

    .footer-meta {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* TOAST NOTIFICATION */
    .toast-msg {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background-color: var(--bg-surface-elevated);
      color: #ffffff;
      border: 1px solid var(--accent-emerald);
      padding: 12px 20px;
      border-radius: var(--radius-sm);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
      font-size: 13px;
      font-weight: 500;
      z-index: 999;
      opacity: 0;
      transform: translateY(10px);
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }

    .toast-msg.show {
      opacity: 1;
      transform: translateY(0);
    }
  </style>
