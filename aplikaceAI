    // --- 4. TACTICS BOARD & FORMATIONS ---
    const defaultPlayers = [
      { id: 1, name: "Staněk", num: 1, role: "GK", x: 10, y: 50, isGK: true },
      { id: 2, name: "Douděra", num: 21, role: "RB", x: 28, y: 84 },
