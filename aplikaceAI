    function setCoordinates(arr) {
      arr.forEach(item => {
        const p = currentPlayers.find(x => x.id === item.id);
        if (p) {
          p.x = item.x;
          p.y = item.y;
        }
      });
    }

    function updateKitColor(val) {
      kitStyle = val;
      renderPitchPlayers();
    }

    function resetDefaultLineup() {
      currentPlayers = JSON.parse(JSON.stringify(defaultPlayers));
      renderPitchPlayers();
      selectPlayer(10);
      showToast("Rozestavení bylo resetováno.");
    }

    function saveTactics() {
      localStorage.setItem('kreperat_tactics', JSON.stringify(currentPlayers));
      showToast("Taktika byla uložena do lokální paměti.");
    }

    // --- 5. MATCH SIMULATION ENGINE ---
    let matchInterval = null;
    let matchMinute = 0;
    let homeScore = 0;
    let awayScore = 0;
    let matchStats = {
      possHome: 52,
      shotsHome: 0,
      shotsAway: 0,
      shotsTargetHome: 0,
      shotsTargetAway: 0,
      xgHome: 0.0,
      xgAway: 0.0,
      cornersHome: 0,
      cornersAway: 0,
      foulsHome: 0,
      foulsAway: 0,
      cardsHome: 0,
      cardsAway: 0
    };

    function resetMatchState() {
      clearInterval(matchInterval);
      matchInterval = null;
      matchMinute = 0;
      homeScore = 0;
      awayScore = 0;
      matchStats = {
        possHome: 52,
        shotsHome: 0,
        shotsAway: 0,
        shotsTargetHome: 0,
        shotsTargetAway: 0,
        xgHome: 0.0,
        xgAway: 0.0,
        cornersHome: 0,
        cornersAway: 0,
        foulsHome: 0,
        foulsAway: 0,
        cardsHome: 0,
        cardsAway: 0
      };
      document.getElementById('liveScoreboard').textContent = '0 : 0';
      document.getElementById('liveMatchMinute').textContent = "0'";
      document.getElementById('liveMatchPeriod').textContent = "Připraveno k výkopu";
      document.getElementById('liveDotIndicator').style.display = 'none';
      document.getElementById('startMatchBtn').textContent = "Zahájit zápas (Výkop)";
      document.getElementById('commentaryFeed').innerHTML = `
        <div class="comment-item">
          <span class="comment-minute">0'</span>
          <span>Rozhodčí přivádí oba týmy na hrací plochu. Hřiště je v perfektním stavu.</span>
        </div>
      `;
      updateStatsUI();
    }

    function toggleMatchSimulation() {
      if (matchInterval) {
        clearInterval(matchInterval);
        matchInterval = null;
        document.getElementById('startMatchBtn').textContent = "Pokračovat v zápase";
        document.getElementById('liveDotIndicator').style.display = 'none';
        showToast("Zápas pozastaven.");
      } else {
        if (matchMinute >= 90) {
          resetMatchState();
        }
        AudioEngine.whistle();
        document.getElementById('startMatchBtn').textContent = "Pozastavit zápas";
        document.getElementById('liveDotIndicator').style.display = 'inline-block';
        document.getElementById('liveMatchPeriod').textContent = "Živě v průběhu";

        matchInterval = setInterval(simulateMatchTick, 400); // Quick simulation tick
      }
    }

    function simulateMatchTick() {
      matchMinute += 1;
      document.getElementById('liveMatchMinute').textContent = `${matchMinute}'`;

      // Random dynamic events during game
      const rand = Math.random();

      // Home shot or goal chance
      if (rand < 0.14) {
        matchStats.shotsHome++;
        AudioEngine.kick();
        if (Math.random() < 0.45) {
          matchStats.shotsTargetHome++;
          matchStats.xgHome += +(Math.random() * 0.25).toFixed(2);
          // Goal!
          if (Math.random() < 0.28) {
            homeScore++;
            AudioEngine.cheer();
            addCommentary(matchMinute, `GÓÓÓL! SK Slavia Praha skóruje! Šimon Kreperát napálil míč nekompromisně do šibenice!`, 'goal');
          } else {
            addCommentary(matchMinute, `Velká šance Slavie! Brankář hostí vyráží střelu na rohový kop.`);
            matchStats.cornersHome++;
          }
        } else {
          addCommentary(matchMinute, `Střela z dálky v podání domácích míří vedle levé tyče.`);
        }
      } 
      // Away shot or goal chance
      else if (rand > 0.86) {
        matchStats.shotsAway++;
        AudioEngine.kick();
        if (Math.random() < 0.40) {
          matchStats.shotsTargetAway++;
          matchStats.xgAway += +(Math.random() * 0.22).toFixed(2);
          // Away Goal!
          if (Math.random() < 0.25) {
            awayScore++;
            AudioEngine.cheer();
            addCommentary(matchMinute, `GÓL pro AC Sparta Praha! Rychlý brejk zakončený přesnou střelou k tyči.`, 'goal');
          } else {
            addCommentary(matchMinute, `Sparta v nadějné pozici, obrana však střelu včas zblokovala.`);
            matchStats.cornersAway++;
          }
        }
      }
      // Yellow card or foul
      else if (rand > 0.48 && rand < 0.52) {
        if (Math.random() < 0.5) {
          matchStats.foulsHome++;
          if (Math.random() < 0.3) {
            matchStats.cardsHome++;
            addCommentary(matchMinute, `Žlutá karta pro domácího obránce za taktický faul na polovině hřiště.`, 'card');
          }
        } else {
          matchStats.foulsAway++;
          if (Math.random() < 0.3) {
            matchStats.cardsAway++;
            addCommentary(matchMinute, `Žlutá karta pro hráče Sparty za ostrý zákrok ve skluzu.`, 'card');
          }
        }
      }

      // Half-time whistle
      if (matchMinute === 45) {
        AudioEngine.whistle();
        addCommentary(45, `Konec prvního poločasu. Hráči odcházejí do šaten.`);
      }

      // End of Match
      if (matchMinute >= 90) {
        clearInterval(matchInterval);
        matchInterval = null;
        AudioEngine.whistle();
        document.getElementById('liveDotIndicator').style.display = 'none';
        document.getElementById('liveMatchPeriod').textContent = "Konec zápasu";
        document.getElementById('startMatchBtn').textContent = "Odehrát nový zápas";
        addCommentary(90, `Konec utkání! Konečný stav: ${homeScore} : ${awayScore}. Děkujeme za pozornost.`, 'goal');
        showToast(`Zápas skončil: ${homeScore} : ${awayScore}`);
      }

      document.getElementById('liveScoreboard').textContent = `${homeScore} : ${awayScore}`;
      updateStatsUI();
    }

    function addCommentary(min, text, type = '') {
      const feed = document.getElementById('commentaryFeed');
      const item = document.createElement('div');
      item.className = `comment-item ${type}`;
      item.innerHTML = `<span class="comment-minute">${min}'</span><span>${text}</span>`;
      feed.insertBefore(item, feed.firstChild);
    }

    function updateStatsUI() {
      document.getElementById('statPossessionHome').textContent = `${matchStats.possHome}%`;
      document.getElementById('statPossessionAway').textContent = `${100 - matchStats.possHome}%`;
      document.getElementById('statShotsHome').textContent = matchStats.shotsHome;
      document.getElementById('statShotsAway').textContent = matchStats.shotsAway;
      document.getElementById('statShotsTargetHome').textContent = matchStats.shotsTargetHome;
      document.getElementById('statShotsTargetAway').textContent = matchStats.shotsTargetAway;
      document.getElementById('statXGHome').textContent = matchStats.xgHome.toFixed(2);
      document.getElementById('statXGAway').textContent = matchStats.xgAway.toFixed(2);
      document.getElementById('statCornersHome').textContent = matchStats.cornersHome;
      document.getElementById('statCornersAway').textContent = matchStats.cornersAway;
      document.getElementById('statFoulsHome').textContent = matchStats.foulsHome;
      document.getElementById('statFoulsAway').textContent = matchStats.foulsAway;
      document.getElementById('statCardsHome').textContent = matchStats.cardsHome;
      document.getElementById('statCardsAway').textContent = matchStats.cardsAway;
    }

    function makeTacticalAdjustment(type) {
      if (type === 'press') {
        matchStats.possHome = Math.min(68, matchStats.possHome + 4);
        addCommentary(matchMinute || 0, `Trenérský pokyn: Zvýšený presink po celém hřišti!`);
        showToast("Taktika: Zvýšený presink aplikován!");
      } else if (type === 'shoot') {
        matchStats.shotsHome += 1;
        addCommentary(matchMinute || 0, `Trenérský pokyn: Střílet při každé příležitosti!`);
        showToast("Taktika: Příkaz ke střelbě aplikován!");
      } else if (type === 'defend') {
        matchStats.possHome = Math.max(38, matchStats.possHome - 5);
        addCommentary(matchMinute || 0, `Trenérský pokyn: Zahuštění obranného bloku.`);
        showToast("Taktika: Zatažená obrana aplikována!");
      }
      updateStatsUI();
    }

    // --- 6. PENALTY SHOOTOUT GAME ---
    let playerKicks = 0;
    let aiKicks = 0;
    let playerScore = 0;
    let aiScore = 0;
    let isShooting = false;

    function resetPenaltyShootout() {
      playerKicks = 0;
      aiKicks = 0;
      playerScore = 0;
      aiScore = 0;
      isShooting = false;
      document.getElementById('playerPenaltyScore').textContent = '0';
      document.getElementById('aiPenaltyScore').textContent = '0';
      document.getElementById('penaltyMessage').textContent = 'Vyberte jeden ze 6 čtverců v bráně pro střelu na bránu.';
      
      const pDots = document.getElementById('playerDots').children;
      const aDots = document.getElementById('aiDots').children;
      for (let i = 0; i < 5; i++) {
        pDots[i].className = 'kick-dot';
        aDots[i].className = 'kick-dot';
      }

      const ball = document.getElementById('penaltyBall');
      ball.style.transition = 'none';
      ball.style.left = '50%';
      ball.style.bottom = '20px';
      ball.style.transform = 'translateX(-50%) scale(1)';

      const keeper = document.getElementById('keeperFig');
      keeper.style.left = '50%';
      keeper.style.bottom = '0';
    }

    function takePenaltyShot(targetCode) {
      if (isShooting || playerKicks >= 5) return;
      isShooting = true;

      AudioEngine.kick();

      const ball = document.getElementById('penaltyBall');
      const keeper = document.getElementById('keeperFig');
      const targets = {
        'TL': { x: 22, y: 160 },
        'TC': { x: 50, y: 175 },
        'TR': { x: 78, y: 160 },
        'BL': { x: 22, y: 40 },
        'BC': { x: 50, y: 30 },
        'BR': { x: 78, y: 40 }
      };

      const shot = targets[targetCode];

      // Keeper AI decision: dives to one of the 6 zones
      const zones = ['TL', 'TC', 'TR', 'BL', 'BC', 'BR'];
      const keeperDive = zones[Math.floor(Math.random() * zones.length)];
      const keeperTarget = targets[keeperDive];

      // Move Goalkeeper
      keeper.style.left = `${keeperTarget.x}%`;
      keeper.style.bottom = `${keeperTarget.y - 30}px`;

      // Move Ball
      ball.style.transition = 'all 0.45s cubic-bezier(0.2, 0.9, 0.4, 1.1)';
      ball.style.left = `${shot.x}%`;
      ball.style.bottom = `${shot.y}px`;
      ball.style.transform = 'translateX(-50%) scale(0.65)';

      setTimeout(() => {
        const isSaved = (keeperDive === targetCode);
        const pDots = document.getElementById('playerDots').children;

        if (!isSaved) {
          playerScore++;
          AudioEngine.cheer();
          document.getElementById('penaltyMessage').textContent = `GÓL! Skvělé zakončení do zóny ${targetCode}!`;
          pDots[playerKicks].className = 'kick-dot scored';
        } else {
          document.getElementById('penaltyMessage').textContent = `CHYCENO! Brankář vystihl směr vaší střely!`;
          pDots[playerKicks].className = 'kick-dot missed';
        }

        document.getElementById('playerPenaltyScore').textContent = playerScore;
        playerKicks++;

        // Simulate AI Kick after 1 second
        setTimeout(() => {
          simulateAIKick();
        }, 900);

      }, 450);
    }

    function simulateAIKick() {
      const aDots = document.getElementById('aiDots').children;
      const aiScored = Math.random() < 0.65; // 65% AI success

      if (aiScored) {
        aiScore++;
        AudioEngine.cheer();
        aDots[aiKicks].className = 'kick-dot scored';
      } else {
        aDots[aiKicks].className = 'kick-dot missed';
      }

      aiKicks++;
      document.getElementById('aiPenaltyScore').textContent = aiScore;

      // Reset Ball for next round
      setTimeout(() => {
        const ball = document.getElementById('penaltyBall');
        ball.style.transition = 'none';
        ball.style.left = '50%';
        ball.style.bottom = '20px';
        ball.style.transform = 'translateX(-50%) scale(1)';

        const keeper = document.getElementById('keeperFig');
        keeper.style.left = '50%';
        keeper.style.bottom = '0';

        isShooting = false;

        if (playerKicks >= 5) {
          let outcome = "Rozstřel skončil nerozhodně!";
          if (playerScore > aiScore) outcome = "VÍTĚZSTVÍ! Vyhráli jste penaltový rozstřel!";
          else if (aiScore > playerScore) outcome = "PORÁŽKA! Brankář a soupeř vás přemohli.";
          document.getElementById('penaltyMessage').textContent = outcome;
          showToast(outcome);
        } else {
          document.getElementById('penaltyMessage').textContent = `Kolo ${playerKicks + 1} z 5: Zvolte další střelu.`;
        }
      }, 600);
    }

    // --- 7. TOURNAMENT & LEAGUE ---
    const initialLeagueTeams = [
      { name: "SK Slavia Praha", p: 14, w: 12, d: 2, l: 0, gf: 38, ga: 6, pts: 38 },
      { name: "AC Sparta Praha", p: 14, w: 11, d: 1, l: 2, gf: 34, ga: 12, pts: 34 },
      { name: "FC Viktoria Plzeň", p: 14, w: 9, d: 3, l: 2, gf: 28, ga: 14, pts: 30 },
      { name: "FC Baník Ostrava", p: 14, w: 7, d: 3, l: 4, gf: 22, ga: 18, pts: 24 },
      { name: "FK Mladá Boleslav", p: 14, w: 5, d: 4, l: 5, gf: 20, ga: 22, pts: 19 },
      { name: "FC Slovan Liberec", p: 14, w: 4, d: 4, l: 6, gf: 17, ga: 24, pts: 16 }
    ];

    function renderLeagueTable() {
      const tbody = document.getElementById('leagueTableBody');
      tbody.innerHTML = '';

      initialLeagueTeams.forEach((team, idx) => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td style="font-weight:600; text-align:left;">
            <span style="color:var(--text-dim); margin-right:6px;">${idx + 1}.</span>
            ${team.name}
          </td>
          <td style="text-align:center; font-family:var(--font-mono);">${team.p}</td>
          <td style="text-align:center; font-family:var(--font-mono);">${team.w}</td>
          <td style="text-align:center; font-family:var(--font-mono);">${team.d}</td>
          <td style="text-align:center; font-family:var(--font-mono);">${team.l}</td>
          <td style="text-align:center; font-family:var(--font-mono);">${team.gf}:${team.ga}</td>
          <td style="text-align:right; font-weight:700; font-family:var(--font-mono); color:var(--accent-emerald);">${team.pts}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function simulateFullTournament() {
      AudioEngine.whistle();
      // Semifinals
      const s1 = Math.floor(Math.random() * 3) + 2;
      const s2 = Math.floor(Math.random() * 2);
      const s3 = Math.floor(Math.random() * 3) + 1;
      const s4 = Math.floor(Math.random() * 2);

      document.getElementById('semiScore1').textContent = s1;
      document.getElementById('semiScore2').textContent = s2;
      document.getElementById('semiScore3').textContent = s3;
      document.getElementById('semiScore4').textContent = s4;

      // Final
      const f1 = Math.floor(Math.random() * 3) + 1;
      const f2 = Math.floor(Math.random() * 3);
      document.getElementById('finalScore1').textContent = f1;
      document.getElementById('finalScore2').textContent = f2;

      let winner = f1 >= f2 ? "Slavia Praha" : "Sparta Praha";
      document.getElementById('tournamentWinnerTag').textContent = `🏆 Vítěz poháru: ${winner}!`;
      AudioEngine.cheer();
      showToast(`Pohár vyhrává tým ${winner}!`);
    }

    // --- 8. FOOTBALL TRIVIA QUIZ ---
    const quizData = [
      {
        question: "Který klub vyhrál historicky nejvíce titulů v Lize mistrů UEFA (včetně PMEZ)?",
        category: "Liga mistrů",
        options: ["Bayern München", "AC Milán", "Real Madrid", "FC Barcelona"],
        correct: 2,
        explanation: "Real Madrid ovládl Ligu mistrů rekordních 15krát."
      },
      {
        question: "Kdo je historicky nejlepším střelcem české fotbalové reprezentace?",
        category: "Česká reprezentace",
        options: ["Milan Baroš", "Jan Koller", "Pavel Nedvěd", "Patrik Schick"],
        correct: 1,
        explanation: "Jan Koller vstřelil v dresu národního týmu úctyhodných 55 gólů v 91 zápasech."
      },
      {
        question: "Ve kterém roce vyhrál Pavel Nedvěd prestižní Zlatý míč (Ballon d'Or)?",
        category: "Ocenění & Legendy",
        options: ["1996", "2001", "2003", "2006"],
        correct: 2,
        explanation: "Pavel Nedvěd získal Zlatý míč v roce 2003 po fantastické sezóně v Juventusu Turín."
      },
      {
        question: "Která země vyhrála Mistrovství světa ve fotbale v roce 2022 v Kataru?",
        category: "Mistrovství světa",
        options: ["Francie", "Argentina", "Brazílie", "Chorvatsko"],
        correct: 1,
        explanation: "Argentina s kapitánem Lionelem Messim zvítězila po penaltovém rozstřelu s Francií."
      },
      {
        question: "Jaký je maximální povolený počet střídání v základní hrací době v profesionálním fotbale dle pravidel IFAB?",
        category: "Fotbalová pravidla",
        options: ["3 střídání", "4 střídání", "5 střídání (ve 3 přerušeních)", "6 střídání"],
        correct: 2,
        explanation: "Od roku 2020 pravidla povolují 5 střídání ve 3 herních slotech."
      }
    ];

    let currentQuizIndex = 0;
    let quizScore = 0;
    let quizAnswered = false;

    function renderCurrentQuiz() {
      const q = quizData[currentQuizIndex];
      quizAnswered = false;
      document.getElementById('quizIndexTag').textContent = `Otázka ${currentQuizIndex + 1} z ${quizData.length}`;
      document.getElementById('quizCategoryTag').textContent = q.category;
      document.getElementById('quizQuestionText').textContent = q.question;
      document.getElementById('quizExplanation').style.display = 'none';
      document.getElementById('nextQuestionBtn').style.display = 'none';

      const container = document.getElementById('quizOptionsContainer');
      container.innerHTML = '';

      q.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = 'quiz-btn';
        btn.innerHTML = `<span>${opt}</span><span style="font-weight:700; color:var(--text-dim);">${String.fromCharCode(65 + idx)}</span>`;
        btn.onclick = () => handleQuizAnswer(idx, btn);
        container.appendChild(btn);
      });
    }

    function handleQuizAnswer(selectedIndex, selectedBtn) {
      if (quizAnswered) return;
      quizAnswered = true;

      const q = quizData[currentQuizIndex];
      const buttons = document.querySelectorAll('.quiz-btn');

      buttons.forEach((btn, idx) => {
        btn.disabled = true;
        if (idx === q.correct) {
          btn.classList.add('correct');
        }
      });

      if (selectedIndex === q.correct) {
        quizScore++;
        AudioEngine.cheer();
        showToast("Správná odpověď!");
      } else {
        selectedBtn.classList.add('wrong');
        showToast("Bohužel špatně!");
      }

      document.getElementById('quizScoreHeader').textContent = `Skóre: ${quizScore} / ${quizData.length}`;
      const expl = document.getElementById('quizExplanation');
      expl.innerHTML = `<strong>Vysvětlení:</strong> ${q.explanation}`;
      expl.style.display = 'block';

      document.getElementById('nextQuestionBtn').style.display = 'inline-flex';
    }

    function nextQuizQuestion() {
      currentQuizIndex++;
      if (currentQuizIndex < quizData.length) {
        renderCurrentQuiz();
      } else {
        // Quiz completed
        const box = document.getElementById('quizCardBox');
        box.innerHTML = `
          <div style="text-align:center; padding:20px;">
            <h2 style="font-size:24px; font-weight:800; color:#fff; margin-bottom:10px;">Kvíz dokončen!</h2>
            <p style="font-size:16px; color:var(--text-muted); margin-bottom:20px;">
              Vaše konečné skóre: <strong style="color:var(--accent-emerald); font-size:22px;">${quizScore} z ${quizData.length}</strong>
            </p>
            <button class="btn-action" onclick="restartQuiz()">Zkusit znovu</button>
          </div>
        `;
        showToast(`Kvíz dokončen se skóre ${quizScore}/${quizData.length}`);
      }
    }

    function restartQuiz() {
      currentQuizIndex = 0;
      quizScore = 0;
      renderCurrentQuiz();
      document.getElementById('quizScoreHeader').textContent = `Skóre: 0 / ${quizData.length}`;
    }

    // --- 9. EXPORT & BACKUP DATA ---
    function exportData() {
      const backup = {
        author: "Šimon Kreperát",
        project: "Fotbalový Manažer & Taktický Simulátor",
        date: new Date().toISOString(),
        tactics: currentPlayers,
        matchHistory: { homeScore, awayScore, stats: matchStats }
      };
      const blob = new Blob([JSON.stringify(backup, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'kreperat_fotbal_data.json';
      a.click();
      URL.revokeObjectURL(url);
      showToast("Data byla vyexportována do JSON souboru.");
    }

    // --- INITIALIZATION ---
    window.addEventListener('DOMContentLoaded', () => {
      // Load saved tactics if available
      const saved = localStorage.getItem('kreperat_tactics');
      if (saved) {
        try {
          currentPlayers = JSON.parse(saved);
        } catch (e) {
          console.error(e);
        }
      }

      renderPitchPlayers();
      selectPlayer(10);
      renderLeagueTable();
      renderCurrentQuiz();
    });
  </script>
</body>
</html>
