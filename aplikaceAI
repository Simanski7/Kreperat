    function renderPitchPlayers() {
      const container = document.getElementById('pitchPlayersLayer');
      container.innerHTML = '';

      currentPlayers.forEach(p => {
        const el = document.createElement('div');
        el.className = 'pitch-player';
        el.style.left = `${p.x}%`;
        el.style.top = `${p.y}%`;
        el.setAttribute('data-id', p.id);

        const circle = document.createElement('div');
        circle.className = `jersey-circle ${p.isGK ? 'gk' : (kitStyle === 'away' ? 'away' : '')}`;
        circle.textContent = p.num;

        const label = document.createElement('div');
        label.className = 'player-label';
        label.textContent = `${p.name} (${p.role})`;

        el.appendChild(circle);
        el.appendChild(label);

        // Click to select
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          selectPlayer(p.id);
        });

        // Drag handlers
        makeDraggable(el, p);

        container.appendChild(el);
      });
    }

    function makeDraggable(el, playerObj) {
      let isDragging = false;
      let startX, startY;

      function onStart(e) {
        isDragging = true;
        const evt = e.touches ? e.touches[0] : e;
        startX = evt.clientX;
        startY = evt.clientY;
        el.style.zIndex = '30';
        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onEnd);
        document.addEventListener('touchmove', onMove, { passive: false });
        document.addEventListener('touchend', onEnd);
      }

      function onMove(e) {
        if (!isDragging) return;
        if (e.cancelable) e.preventDefault();
        const pitch = document.getElementById('pitchArea');
        const rect = pitch.getBoundingClientRect();
        const evt = e.touches ? e.touches[0] : e;

        let posX = ((evt.clientX - rect.left) / rect.width) * 100;
        let posY = ((evt.clientY - rect.top) / rect.height) * 100;

        posX = Math.max(5, Math.min(95, posX));
        posY = Math.max(8, Math.min(92, posY));

        playerObj.x = Math.round(posX);
        playerObj.y = Math.round(posY);

        el.style.left = `${playerObj.x}%`;
        el.style.top = `${playerObj.y}%`;
      }

      function onEnd() {
        if (!isDragging) return;
        isDragging = false;
        el.style.zIndex = '10';
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onEnd);
        document.removeEventListener('touchmove', onMove);
        document.removeEventListener('touchend', onEnd);
      }

      el.addEventListener('mousedown', onStart);
      el.addEventListener('touchstart', onStart, { passive: true });
    }

    function selectPlayer(id) {
      selectedPlayerId = id;
      const p = currentPlayers.find(x => x.id === id);
      if (p) {
        document.getElementById('editPlayerName').value = p.name;
        document.getElementById('editPlayerNumber').value = p.num;
        document.getElementById('editPlayerRole').value = p.role;
